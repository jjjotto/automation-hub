<Window x:Class="AutomationHub.App.Views.JobSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Job Settings"
        Height="520"
        Width="600"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </Window.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="16" Orientation="Vertical">
            <TextBlock Text="Job Properties" FontWeight="Bold" FontSize="16" />

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,8,0,0">
                <TextBlock Text="Name:" Width="120" VerticalAlignment="Center" />
                <TextBox Text="{Binding Name}" Width="320" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,4,0,0">
                <TextBlock Text="Type:" Width="120" VerticalAlignment="Center" />
                <ComboBox ItemsSource="{Binding JobTypeOptions}"
                          SelectedItem="{Binding Type}"
                          Width="200" />
            </StackPanel>

            <CheckBox Content="Enabled" IsChecked="{Binding Enabled}" />

            <GroupBox Header="Process" Padding="12">
                <StackPanel Orientation="Vertical">
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBlock Text="Command" Width="120" VerticalAlignment="Center" />
                        <TextBox Text="{Binding Process.Command}" Width="320" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBlock Text="Arguments" Width="120" VerticalAlignment="Center" />
                        <TextBox Text="{Binding Process.Arguments}" Width="320" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBlock Text="Working Directory" Width="120" VerticalAlignment="Center" />
                        <TextBox Text="{Binding Process.WorkingDirectory}" Width="320" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBlock Text="Timeout (minutes)" Width="120" VerticalAlignment="Center" />
                        <TextBox Text="{Binding Process.TimeoutMinutes}" Width="120" />
                    </StackPanel>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="File Trigger" Padding="12" Visibility="{Binding IsFileTriggerVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel Orientation="Vertical">
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBlock Text="Watch Path" Width="120" VerticalAlignment="Center" />
                        <TextBox Text="{Binding FileTrigger.WatchPath}" Width="320" />
                    </StackPanel>
                    <CheckBox Content="Include subfolders" IsChecked="{Binding FileTrigger.IncludeSubfolders}" />
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <TextBlock Text="Filters" Width="120" VerticalAlignment="Top" />
                        <StackPanel>
                            <ItemsControl ItemsSource="{Binding FileTrigger.Filters}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                            <ComboBox Width="140"
                                                      ItemsSource="{Binding DataContext.FileTrigger.FilterKindOptions, RelativeSource={RelativeSource AncestorType=GroupBox}}"
                                                      SelectedItem="{Binding Kind}" />
                                            <TextBox Width="220" Margin="8,0,0,0" Text="{Binding Pattern}" />
                                            <Button Content="Remove"
                                                    Margin="8,0,0,0"
                                                    Padding="8,2"
                                                    Tag="{Binding}"
                                                    Click="OnRemoveFilterClicked" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button Content="Add Filter" Width="120" Margin="0,8,0,0" Click="OnAddFilterClicked" />
                            <TextBlock Text="All filters must pass. Combine startsWith and endsWith to mirror AutoQC naming patterns." Margin="0,8,0,0" Foreground="Gray" TextWrapping="Wrap" Width="320" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </GroupBox>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                <Button Content="Save" Width="100" Click="OnSaveClicked" />
                <Button Content="Cancel" Width="100" Click="OnCancelClicked" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Window>

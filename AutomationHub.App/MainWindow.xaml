<Window x:Class="AutomationHub.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AutomationHub.App"
        mc:Ignorable="d"
        Title="Automation Hub" Height="450" Width="960">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <DockPanel>
            <TextBlock Text="Automation Hub Jobs"
                       FontSize="20"
                       FontWeight="Bold"
                       DockPanel.Dock="Left"
                       VerticalAlignment="Center" />
            <Button Content="Add Job"
                    Width="90"
                    Margin="8,0,0,0"
                    HorizontalAlignment="Right"
                    Click="OnAddJobClicked" />
        </DockPanel>

        <DataGrid Grid.Row="1"
                  ItemsSource="{Binding Jobs}"
                  AutoGenerateColumns="False"
                  HeadersVisibility="Column"
                  Margin="0,12,0,12">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Name" Binding="{Binding Job.Name}" Width="2*" />
                <DataGridTextColumn Header="Type" Binding="{Binding Job.Type}" Width="*" />
                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="2*" />
                <DataGridCheckBoxColumn Header="Enabled" Binding="{Binding Job.Enabled}" Width="Auto" />
                <DataGridTextColumn Header="Command" Binding="{Binding Job.Process.Command}" Width="2*" />
                <DataGridTextColumn Header="Trigger Path" Binding="{Binding Job.FileTrigger.WatchPath}" Width="2*" />
                <DataGridTemplateColumn Header="Log" Width="Auto">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="View Log"
                                    Padding="8,2"
                                    Margin="4,0"
                                    Click="OnViewLogClicked" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Settings" Width="Auto">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="Settings..."
                                    Padding="8,2"
                                    Margin="4,0"
                                    Click="OnJobSettingsClicked" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock Grid.Row="2"
                   Text="{Binding StatusMessage}"
                   FontStyle="Italic"
                   Foreground="Gray" />
    </Grid>
</Window>
